# Explicitly opt into isolated editorial fixtures for screenshots; never an API error fallback.
SEA_ENABLE_DEMO=0
# RTW domain API; gateway forwards /api/sea/* to /v1/* by default.
# SEA_PRODUCT_API_SERVER_URL=http://localhost:8888
# Only isolated local acceptance may explicitly select RTW v2 for the three
# knowledge answer-history GETs. Production pages remain on v1 by default.
# SEA_KNOWLEDGE_HISTORY_READ_VERSION=v2
# Existing .env.example service variables remain applicable.
